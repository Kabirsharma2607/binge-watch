// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                Int               @id @default(autoincrement())
  user_id           String            @unique @default(uuid())
  name              String
  username          String            @unique
  email             String            @unique
  authDetails       auth_details?      @relation
  user_current_room room_details?      @relation(fields: [roomDetailsId], references: [id])
  roomDetailsId     Int?
  room_participant   room_participant[]

  @@index([id])
  @@index([user_id])
}

model auth_details {
  id       Int    @id @default(autoincrement())
  password String
  user_id  String @unique
  user     users   @relation(fields: [user_id], references: [user_id])

  @@index([id])
  @@index([user_id])
}

model room_participant {
  id      Int         @id @default(autoincrement())
  room_id BigInt
  user_id String
  room    room_details @relation(fields: [room_id], references: [room_id])
  user    users        @relation(fields: [user_id], references: [user_id])

  @@unique([room_id, user_id])
}

model room_details {
  id           Int               @id @default(autoincrement())
  room_id      BigInt            @unique @default(dbgenerated())
  name         String
  capacity     Int
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  participants room_participant[] @relation
  User         users[]

  @@index([id])
}
