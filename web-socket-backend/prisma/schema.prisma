generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model auth_details {
  id       Int    @id @default(autoincrement())
  password String
  user_id  String @unique
  users    users  @relation(fields: [user_id], references: [user_id])

  @@index([id])
  @@index([user_id])
}

model room_details {
  id               Int                @id @default(autoincrement())
  room_id          String             @unique
  name             String
  capacity         Int
  created_at       DateTime           @default(now())
  updated_at       DateTime
  curr_capacity    Int                @default(0)
  room_participant room_participant[]

  @@index([id])
  @@index([room_id])
}

model room_participant {
  id           Int          @id @default(autoincrement())
  room_id      String
  user_id      String
  room_details room_details @relation(fields: [room_id], references: [room_id])
  users        users        @relation(fields: [user_id], references: [user_id])

  @@unique([room_id, user_id])
  @@index([room_id])
}

model users {
  id               Int                @id @default(autoincrement())
  user_id          String             @unique
  name             String
  username         String             @unique
  email            String             @unique
  auth_details     auth_details?
  room_participant room_participant[]

  @@index([id])
  @@index([user_id])
}
